{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@elizaos/core": ["../../../packages/typescript/dist"]
    }
  },
  "include": ["index.ts", "index.node.ts", "index.browser.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "python",
    "rust",
    "build.ts",
    "vitest.config.ts",
    "**/__tests__/**",
    "**/*.test.ts"
  ]
}
